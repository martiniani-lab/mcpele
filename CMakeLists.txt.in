# this file is meant to be parsed by python (setup.py) before being a proper CMakeLists.txt file
# in particular, the following strings will be set by python
cmake_minimum_required(VERSION 3.18)
project(mcpele CXX C)

set(numpy_include __NUMPY_INCLUDE__)
set(PYTHON_INCLUDE_DIRS __PYTHON_INCLUDE__)
set(PYTHON_LDFLAGS "__PYTHON_LDFLAGS__")
# pele's C++ sources and headers, from pele.get_include()
set(pele_include __PELE_INCLUDE__)
# prefer sundials/eigen from pele's extern/install (source checkouts), then the environment
list(APPEND CMAKE_PREFIX_PATH __EXTRA_PREFIX_PATH__)

# osx makes the suffix for shared object libraries .dylib
IF(APPLE)
  SET(CMAKE_SHARED_LIBRARY_SUFFIX ".so")
ENDIF(APPLE)

message("python include dirs: ${PYTHON_INCLUDE_DIRS}")
message("numpy include dirs: ${numpy_include}")
message("pele include dirs: ${pele_include}")
include_directories(${numpy_include})
include_directories(${PYTHON_INCLUDE_DIRS})
include_directories(${pele_include})

# On Linux extensions must not link libpython (symbols resolve at import, and
# conda-forge's python is static). macOS needs the flags.
unset(CMAKE_SHARED_LINKER_FLAGS CACHE)
if(APPLE)
  set(CMAKE_SHARED_LINKER_FLAGS ${PYTHON_LDFLAGS} CACHE STRING flags)
endif()

# #################################### sundials / eigen ###############################
# (pele's sources include cvode.cpp, so mcpele needs sundials too)
find_package(Eigen3 CONFIG QUIET)
if(TARGET Eigen3::Eigen)
  get_target_property(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
else()
  find_path(EIGEN3_INCLUDE_DIR Eigen/Dense REQUIRED)
endif()
# lapacke.h comes with Eigen
set(LAPACKE_INCLUDE_DIR ${EIGEN3_INCLUDE_DIR}/Eigen/src/misc)

# plain find_library rather than SUNDIALS' exported targets: those can carry
# absolute paths of the toolchain sundials was built with
find_path(SUNDIALS_INCLUDE_DIR cvode/cvode.h REQUIRED)
find_library(SUNDIALS_CVODE_LIB sundials_cvode REQUIRED)
find_library(SUNDIALS_NVEC_LIB sundials_nvecserial REQUIRED)
find_library(SUNDIALS_CORE_LIB sundials_core)  # split out in sundials 7
set(SUNDIALS_LIBRARIES ${SUNDIALS_CVODE_LIB} ${SUNDIALS_NVEC_LIB})
if(SUNDIALS_CORE_LIB)
  list(APPEND SUNDIALS_LIBRARIES ${SUNDIALS_CORE_LIB})
endif()
message("SUNDIALS: ${SUNDIALS_INCLUDE_DIR} ${SUNDIALS_LIBRARIES}")
message("eigen include dir: ${EIGEN3_INCLUDE_DIR}")

find_package(LAPACK REQUIRED)
#####################################################################################

SET(CMAKE_CXX_FLAGS __COMPILER_EXTRA_ARGS__)

# set the mcpele include directory
set(mcpele_include ${CMAKE_SOURCE_DIR}/source)
include_directories(${mcpele_include})
include_directories(SYSTEM ${EIGEN3_INCLUDE_DIR})
include_directories(SYSTEM ${SUNDIALS_INCLUDE_DIR})
include_directories(SYSTEM ${LAPACKE_INCLUDE_DIR})
message("mcpele include directory: ${mcpele_include}")

# build the mcpele library, static so the installed extensions don't depend on a
# libmcpele_lib.so in the build dir
FILE(GLOB pele_sources ${pele_include}/*.c*)
FILE(GLOB mcpele_sources ${mcpele_include}/*.c*)
add_library(mcpele_lib STATIC ${mcpele_sources} ${pele_sources})
set_target_properties(mcpele_lib PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(mcpele_lib PUBLIC ${SUNDIALS_LIBRARIES} ${LAPACK_LIBRARIES})

function(make_cython_lib cython_cxx_source)
  get_filename_component(library_name ${cython_cxx_source} NAME)
  string(REGEX REPLACE ".cxx$" "" library_name ${library_name})
  add_library(${library_name} SHARED ${cython_cxx_source})
  target_link_libraries(${library_name} PUBLIC mcpele_lib)
  if(APPLE)
    target_link_options(${library_name} PUBLIC "LINKER:-undefined,dynamic_lookup")
  endif()
  set_target_properties(${library_name} PROPERTIES PREFIX "")
  set_target_properties(${library_name} PROPERTIES SUFFIX ".so")
  message("making library ${library_name} from source ${cython_cxx_source}")
endfunction(make_cython_lib)
